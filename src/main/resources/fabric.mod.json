{
  "schemaVersion": 1,
  "id": "overlayer",
  "version": "${version}",
  "name": "Overlayer",
  "description": "Overlay custom images anywhere on your game screen, with full control over position, scale, opacity, and layer order.",
  "authors": [
    "Skrepy2233"
  ],
  "contact": {
    "homepage": "https://github.com/Skrepy0/Overlayer",
    "sources": "https://github.com/Skrepy0/Overlayer"
  },
  "license": "MIT",
  "icon": "assets/overlayer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.skrepy.overlayer.Overlayer"
    ],
    "client": [
      "com.skrepy.overlayer.OverlayerClient"
    ],
    "fabric-datagen": [
      "com.skrepy.overlayer.OverlayerDataGenerator"
    ],
    "modmenu": [
      "com.skrepy.overlayer.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "overlayer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.20",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}